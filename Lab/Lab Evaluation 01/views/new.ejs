<!DOCTYPE html>
<html>
<head>
    <title>Add Task</title>
    <style>
        body { font-family: sans-serif; padding: 20px; }
        .form-group { margin-bottom: 15px; }
        label { font-weight: bold; }
    </style>
</head>
<body>
    <h1>Add a New Task</h1>
    
    <% if (error) { %>
        <p style="color: red; font-weight: bold;"><%= error %></p>
    <% } %>

    <form action="/tasks" method="POST">
        <div class="form-group">
            <label>Title:</label><br>
            <input type="text" name="title" required style="width: 300px;">
        </div>
        
        <div class="form-group">
            <label>Description:</label><br>
            <textarea name="description" rows="4" style="width: 300px;"></textarea>
        </div>
        
        <div class="form-group">
            <label>
                <input type="checkbox" name="isUrgent"> Is Urgent
            </label>
        </div>
        
        <div class="form-group">
            <label>
                <input type="checkbox" name="isImportant"> Is Important
            </label>
        </div>
        
        <button type="submit" style="padding: 10px 20px; background: #28a745; color: white; border: none;">Save Task</button>
        <a href="/tasks" style="margin-left: 10px;">Cancel</a>
    </form>
</body>
</html>
